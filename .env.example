# ---------------------------------------------------------------------------
# LLM — one provider, one model. No routing, no fallback between models.
# ---------------------------------------------------------------------------
# claude_cli : uses the locally installed `claude` binary. No API key, no
#              metered spend. This is the default so the demo runs out of the box.
# anthropic  : calls the Anthropic SDK directly. Needs LLM_API_KEY.
LLM_PROVIDER=claude_cli
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_TIMEOUT_S=90

# ---------------------------------------------------------------------------
# ASR — local Whisper. The model downloads once on first run (~75 MB).
# ---------------------------------------------------------------------------
ASR_PROVIDER=faster_whisper
ASR_MODEL_SIZE=base.en
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# Transcripts under this confidence go to the fallback handler, not the LLM.
ASR_MIN_CONFIDENCE=0.55

# ---------------------------------------------------------------------------
# TTS
# ---------------------------------------------------------------------------
# edge_tts  : free neural voices, needs network, no API key
# macos_say : fully offline, uses the built-in macOS `say` binary
TTS_PROVIDER=edge_tts
TTS_VOICE=en-IN-NeerjaNeural
TTS_MACOS_VOICE=Samantha
TTS_OFFLINE_FALLBACK=true

# ---------------------------------------------------------------------------
# Postgres (required — SQLite is not supported)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://coach:coach@localhost:5432/speaking_coach

# ---------------------------------------------------------------------------
# Session shape
# ---------------------------------------------------------------------------
SESSION_MAX_TURNS=10
SESSION_MAX_MINUTES=10
BASELINE_TURNS=3
